{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "0bin-cloudflare",
  "main": "./src/server.ts",
  // Pinned to the workerd bundled with @cloudflare/vitest-pool-workers, or the integration tests refuse to start.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "paste.h1n054ur.dev", "custom_domain": true }],
  "observability": { "enabled": true, "logs": { "invocation_logs": true } },
  "upload_source_maps": true,

  // Client bundle comes from Workers Static Assets; every page is server-rendered and /api/* is Hono.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg", "!/favicon.ico", "!/apple-touch-icon.png"]
  },

  // Migrations are applied by `bun run deploy` before the new code goes live.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "0bin-cloudflare-db",
      "database_id": "c6acfaac-ba3e-4283-88ff-744aa83c483d",
      "migrations_dir": "./migrations"
    }
  ],

  // Hourly purge of expired pastes (src/server.ts scheduled).
  "triggers": { "crons": ["17 * * * *"] },

  // Create brake (spec 7.2): 10 creates per 60 s per client IP.
  "ratelimits": [{ "name": "CREATE_LIMITER", "namespace_id": "5001", "simple": { "limit": 10, "period": 60 } }],

  // CREATE_MODE gates POST /api/pastes and GET /api/stats: "off" (also any unknown value) answers 404, "open"
  // lets anyone in (rate limited per IP), "token" requires `Authorization: Bearer <CREATE_TOKEN>` (secret; unset
  // means 401 for everyone). /api/admin/* always requires `Authorization: Bearer <ADMIN_TOKEN>` (secret); without
  // ADMIN_TOKEN the admin API answers 404.
  "vars": { "CREATE_MODE": "open" }
}
